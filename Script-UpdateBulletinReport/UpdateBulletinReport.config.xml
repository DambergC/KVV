<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <Database>
    <SqlInstance>servername</SqlInstance>
    <DatabaseName>DB</DatabaseName>
  </Database>
    <Query>

    <DaysBack>1</DaysBack>

    <ExcludeTitleContains>
      <Pattern>25H2</Pattern>
      <Pattern>26H1</Pattern>
      <Pattern>arm64</Pattern>
      <Pattern>Defender</Pattern>
      <Pattern>Apps</Pattern>
      <Pattern>Edge-Beta</Pattern>
      <Pattern>Edge-Dev</Pattern>
      <Pattern>x86</Pattern>
      <Pattern>Office 2019</Pattern>
      <Pattern>Office LTSC 2021</Pattern>
    </ExcludeTitleContains>

    <ExcludeDescriptionContains>
        <Pattern>Install the latest version of Windows</Pattern>
    </ExcludeDescriptionContains>

  </Query>

    <Logging>
    <LogPath>d:\Scripts\UpdateBulletinReport\LogFiles\UpdateBulletinReport.log</LogPath>
  </Logging>

  <Email>
    <SmtpServer>smtp.company.se</SmtpServer>
    <SmtpPort>25</SmtpPort>
    <From>noreply@company.se</From>
    <!-- Multiple recipients are supported -->
    <To>
      <Recipient>christian.damberg@company.se</Recipient>
      <Recipient>HK.IT.CMKalendern@company.se</Recipient>
    </To>
    <Subject>Recent Software Update Bulletins</Subject>
    <!-- Use image/png, image/jpeg, or image/gif -->
    <HtmlLogoMimeType>image/png</HtmlLogoMimeType>
    <!--
      Store the complete Base64 data URI here.
      Example:
      data:image/png;base64,iVBORw0KGgoAAAANSUhEUg...
    -->
    <HtmlLogo><![CDATA[data:image/png;base64,"Din krypterade logo här"]]></HtmlLogo>
  </Email>
</Configuration>
